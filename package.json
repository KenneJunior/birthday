{
  "name": "birthday",
  "version": "1.0.0",
  "private": true,
  "description": "A site that was build to celebrate the birthday of fhavur",
  "keywords": [
    "birthday",
    "celebrate",
    "joy",
    "fhavur",
    "celebration"
  ],
  "homepage": "https://github.com/KenneJunior/birthday#readme",
  "bugs": {
    "url": "https://github.com/KenneJunior/birthday/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KenneJunior/birthday.git"
  },
  "license": "MIT",
  "author": "kenne Junior",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "media-json": "node src/scripts/generate-media-json.js",
    "robots": "node src/scripts/generate-robots.js",
    "robots:dev": "node src/scripts/generate-robots.js development",
    "build:sw": "node src/scripts/build-offline-page.js",
    "prebuild": "node src/scripts/pre-build.js",
    "build": "vite build && node src/scripts/copy-sw.js && npm run build:sw",
    "dev": "vite",
    "preview": "vite preview",
    "v-build": "vercel build",
    "v-dev": "vercel dev",
    "v-deploy": "vercel deploy --prod",
    "v-deploy-dev": "vercel deploy --prebuilt --prod",
    "v-deploy-preview": "vercel deploy --prebuilt",
    "v-deploy-preview-dev": "vercel deploy --prebuilt"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.7.0",
    "@kennejunior/liquidglass": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "error-stack-parser": "^2.1.4",
    "hammerjs": "^2.0.8",
    "pwa-asset-generator": "^8.1.2",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "html-minifier-terser": "^7.2.0",
    "sitemap": "^9.0.1",
    "terser": "^5.44.0",
    "vite": "^7.1.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-html-minifier-terser": "^3.8.0",
    "vite-plugin-qrcode": "^0.3.0"
  }
}
